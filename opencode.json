{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "qdrant": {
      "type": "local",
      "command": ["uvx", "mcp-server-qdrant"],
      "environment": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "opencode-memories",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "enabled": true
    },
    "qdrantPicasso": {
      "type": "local",
      "command": ["uvx", "mcp-server-qdrant"],
      "environment": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "picasso-code-embeddings",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "enabled": true
    },
    "searchWeb": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/python3.11",
        "/Users/mr.terry/.config/opencode/mcp/search_web_mcp.py"
      ],
      "enabled": true
    },
    "csharpLsp": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/python3.11",
        "/Users/mr.terry/.config/opencode/mcp/lsp_mcp.py"
      ],
      "environment": {
        "DOTNET_ROOT": "/Users/mr.terry/Applications/opencode-tools/dotnet-sdk-10.0.102-osx-x64",
        "PATH": "/Users/mr.terry/Applications/opencode-tools/dotnet-sdk-10.0.102-osx-x64:/usr/bin:/bin:/usr/sbin:/sbin",
        "LSP_TCP_HOST": "127.0.0.1",
        "LSP_TCP_PORT": "2087"
      },
      "enabled": true
    }
  }
}
